<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_background"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/hold_to_talk"
        android:textColor="@color/kb_status_text"
        android:textSize="13sp" />

    <Button
        android:id="@+id/talk"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/kb_talk"
        android:stateListAnimator="@null"
        android:text="@string/hold_to_talk"
        android:textAllCaps="false"
        android:textColor="@color/kb_talk_text"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/switch_kb"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/kb_key"
            android:contentDescription="@string/kb_switch"
            android:src="@drawable/ic_kb_language" />

        <Button
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="3"
            android:background="@drawable/kb_key"
            android:stateListAnimator="@null"
            android:text="@string/kb_space"
            android:textAllCaps="false"
            android:textColor="@color/kb_status_text"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/backspace"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/kb_key"
            android:contentDescription="@string/kb_backspace"
            android:src="@drawable/ic_kb_backspace" />

        <ImageButton
            android:id="@+id/enter"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/kb_key"
            android:contentDescription="@string/kb_enter"
            android:src="@drawable/ic_kb_enter" />
    </LinearLayout>
</LinearLayout>
