<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Encabezado grande, sin barra superior -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="56dp"
                android:text="@string/app_name"
                android:textColor="@color/app_on_surface"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:text="@string/main_subtitle"
                android:textColor="@color/app_secondary_text"
                android:textSize="14sp" />

            <!-- Estado -->
            <TextView
                style="@style/NeoprarsVoice.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_status" />

            <com.google.android.material.card.MaterialCardView
                style="@style/NeoprarsVoice.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/status_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Dictado: se guarda al instante -->
            <TextView
                style="@style/NeoprarsVoice.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_dictation" />

            <com.google.android.material.card.MaterialCardView
                style="@style/NeoprarsVoice.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/chunked_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/chunked_switch"
                        android:textSize="16sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/language_layout"
                        style="@style/NeoprarsVoice.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/language_label">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/language"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/NeoprarsVoice.Dropdown"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/transcriber_label">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/transcriber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <ImageButton
                            android:id="@+id/transcriber_help"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/key_help_button"
                            android:src="@drawable/ic_help" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pulido: se guarda al instante -->
            <TextView
                style="@style/NeoprarsVoice.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_polish" />

            <com.google.android.material.card.MaterialCardView
                style="@style/NeoprarsVoice.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/polish_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/polish_switch"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/polish_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/NeoprarsVoice.Dropdown"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/polisher_label">

                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/polisher"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <ImageButton
                                android:id="@+id/polisher_help"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="4dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/key_help_button"
                                android:src="@drawable/ic_help" />
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/NeoprarsVoice.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/style_label">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/style"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Claves y modelos: con "Guardar cambios" -->
            <TextView
                style="@style/NeoprarsVoice.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_keys" />

            <com.google.android.material.card.MaterialCardView
                style="@style/NeoprarsVoice.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Una clave por empresa elegida; se arma desde el código. -->
                    <LinearLayout
                        android:id="@+id/key_fields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/transcriber_model_layout"
                        style="@style/NeoprarsVoice.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/model_transcriber_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/transcriber_model"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/polisher_model_layout"
                        style="@style/NeoprarsVoice.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/model_polisher_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/polisher_model"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/NeoprarsVoice.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/vocabulary_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save"
                        style="@style/NeoprarsVoice.PillButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:enabled="false"
                        android:text="@string/save_changes" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Activación: solo lo que falta -->
            <TextView
                style="@style/NeoprarsVoice.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_setup" />

            <com.google.android.material.card.MaterialCardView
                style="@style/NeoprarsVoice.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mic"
                        style="@style/NeoprarsVoice.OutlinedPillButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_mic" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_a11y"
                        style="@style/NeoprarsVoice.OutlinedPillButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_a11y" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_enable"
                        style="@style/NeoprarsVoice.OutlinedPillButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_enable_keyboard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pick"
                        style="@style/NeoprarsVoice.OutlinedPillButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_pick_keyboard" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Prueba -->
            <TextView
                style="@style/NeoprarsVoice.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_test" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/NeoprarsVoice.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/test_field_hint"
                app:boxBackgroundColor="@color/app_surface">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/test_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_about"
                style="@style/NeoprarsVoice.OutlinedPillButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/about_button" />
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
