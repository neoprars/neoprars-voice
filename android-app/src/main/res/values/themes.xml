<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Monocromático, como el teclado y el botón flotante: grafito sobre gris claro (y al revés en modo oscuro). -->
    <style name="Theme.NeoprarsVoice" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/app_accent</item>
        <item name="colorPrimaryVariant">@color/app_accent</item>
        <item name="colorOnPrimary">@color/app_on_accent</item>
        <item name="colorSecondary">@color/app_accent</item>
        <item name="colorOnSecondary">@color/app_on_accent</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_on_surface</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:textColorPrimary">@color/app_on_surface</item>
        <item name="android:textColorSecondary">@color/app_secondary_text</item>
    </style>

    <style name="NeoprarsVoice.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/app_surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">20dp</item>
    </style>

    <style name="NeoprarsVoice.SectionTitle" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/app_secondary_text</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="NeoprarsVoice.Dropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/app_accent</item>
        <item name="hintTextColor">@color/app_accent</item>
    </style>

    <style name="NeoprarsVoice.Field" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/app_accent</item>
        <item name="hintTextColor">@color/app_accent</item>
    </style>

    <style name="NeoprarsVoice.PillButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="NeoprarsVoice.OutlinedPillButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeColor">@color/app_divider</item>
        <item name="android:textColor">@color/app_on_surface</item>
    </style>
</resources>
